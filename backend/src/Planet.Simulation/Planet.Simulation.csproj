<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Planet.Domain\Planet.Domain.csproj" />
    <ProjectReference Include="..\Planet.Generation\Planet.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- v2 P2 的三個表示法候選是 internal（選定之後另外兩個會刪掉），比較測試要看得到 -->
    <InternalsVisibleTo Include="Planet.Simulation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- v2 方向 2：使用者畫的大陸配置草圖（見 ContinentSketch），左＝西、上＝北，寬度是一整圈經度、高度是北極到南極 -->
    <EmbeddedResource Include="Templates\continent-sketch.png" LogicalName="continent-sketch.png" />
    <!-- 使用者在第 0 步板塊圖上改過的海洋板塊範圍（見 ContinentPlateMap） -->
    <EmbeddedResource Include="Templates\plate-override.png" LogicalName="plate-override.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
